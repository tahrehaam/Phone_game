rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랭킹 점수: 누구나 보기 가능, 새 기록 추가만 가능 (수정·삭제는 불가)
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'level', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'score', 'level', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 10
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 100000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // 그 외 모든 데이터는 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
